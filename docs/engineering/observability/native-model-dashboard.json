{
  "uid": "multica-native-model",
  "title": "Multica native model runtime",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "multica",
    "native-model"
  ],
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active runs (all runtimes)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(multica_agent_task_in_progress)",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tool events (all runtimes)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (family, event) (rate(multica_tool_events_total[$__rate_interval]))",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Model HTTP attempts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose, outcome) (rate(multica_model_api_attempts_total[$__rate_interval]))",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Model latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (purpose, le) (rate(multica_model_api_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Model input/output tokens (cached included in input)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose, type) (rate(multica_model_api_tokens_total{type!=\"cached_input\"}[$__rate_interval]))",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Shared quota rejections",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose) (rate(multica_model_api_admission_total{result=\"denied\"}[$__rate_interval]))",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Unknown upstream usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose) (rate(multica_model_api_unknown_usage_total[$__rate_interval]))",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "SDK retry attempts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose) (rate(multica_model_api_retries_total[$__rate_interval]))",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Estimated cost (not a provider bill)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose) (rate(multica_model_api_estimated_cost_usd_total[$__rate_interval])) * 3600",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Reported usage without known pricing",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose) (rate(multica_model_api_unpriced_usage_total[$__rate_interval]))",
          "legendFormat": "{{purpose}} {{outcome}} {{family}} {{event}} {{type}}"
        }
      ]
    }
  ]
}
